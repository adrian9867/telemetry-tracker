# Copy to .env and fill in. .env is git-ignored; never paste real tokens into
# code, chat, logs or DATA_LOG.md.

# GitHub (M10)
# Fine-grained personal access token, read-only, limited to the repos below.
# Only commit timestamps and SHAs are stored, never messages or diffs.
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo-one,owner/repo-two

# Google Calendar (M11)
# Paths to the OAuth client JSON and the cached token. Both are git-ignored.
# Only event start and end are stored, never titles or attendees.
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=
